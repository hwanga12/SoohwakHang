<?xml version="1.0" ?>
<!--
  AgriBot - Farm World
  A simple greenhouse/farm environment for the AgriBot simulation.
-->
<sdf version="1.9">
  <world name="farm_world">
    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (Farm Soil) -->
    <model name="ground_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Extend the drivable floor through the full greenhouse footprint. -->
    <model name="greenhouse_floor_extension">
      <pose>0 140 -0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>60 180 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>60 180 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Keep the detailed greenhouse / crop visuals, but use simple collision
      proxies so physics and LiDAR do not trace against heavy triangle meshes.
    -->
    <model name="greenhouse_collision_proxy">
      <static>true</static>
      <link name="link">
        <collision name="left_wall">
          <pose>-29.6 112.5 2.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 235.0 4.0</size>
            </box>
          </geometry>
        </collision>
        <collision name="right_wall">
          <pose>29.6 112.5 2.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 235.0 4.0</size>
            </box>
          </geometry>
        </collision>
        <collision name="rear_wall">
          <pose>0 229.6 2.0 0 0 0</pose>
          <geometry>
            <box>
              <size>60.0 0.8 4.0</size>
            </box>
          </geometry>
        </collision>
        <collision name="front_wall_left">
          <pose>-17.0 -4.6 2.0 0 0 0</pose>
          <geometry>
            <box>
              <size>26.0 0.8 4.0</size>
            </box>
          </geometry>
        </collision>
        <collision name="front_wall_right">
          <pose>17.0 -4.6 2.0 0 0 0</pose>
          <geometry>
            <box>
              <size>26.0 0.8 4.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="crop_bed_left_collision_proxy">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>-19.92445 115.9957725 0.9 0 0 0</pose>
          <geometry>
            <box>
              <size>15.0299 223.498445 1.8</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="crop_bed_right_collision_proxy">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>21.190872 101.8023525 0.9 0 0 0</pose>
          <geometry>
            <box>
              <size>10.84586 135.535309 1.8</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Greenhouse Structure -->
    <include>
      <uri>model://greenhouse</uri>
      <pose>0 0 0.75 0 0 0</pose>
    </include>

    <!-- AgriBot Robot -->
    <include>
      <uri>model://agribot</uri>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

    <!-- Tomato Plants -->
    <include>
      <name>tomato_plant_1</name>
      <uri>model://tomato_plant</uri>
      <pose>-14.909500 8.246550 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_2</name>
      <uri>model://tomato_plant</uri>
      <pose>24.113802 38.034698 -0.633620 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_3</name>
      <uri>model://tomato_plant</uri>
      <pose>-18.374901 183.241791 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_4</name>
      <uri>model://tomato_plant</uri>
      <pose>18.267942 123.593002 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_5</name>
      <uri>model://tomato_plant</uri>
      <pose>-19.565804 113.801003 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_6</name>
      <uri>model://tomato_plant</uri>
      <pose>-24.939400 36.284130 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_7</name>
      <uri>model://tomato_plant</uri>
      <pose>-23.448051 49.087700 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_8</name>
      <uri>model://tomato_plant</uri>
      <pose>-17.341883 223.744995 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_9</name>
      <uri>model://tomato_plant</uri>
      <pose>18.882439 165.570007 0.75 0 0 0</pose>
    </include>
    <include>
      <name>tomato_plant_10</name>
      <uri>model://tomato_plant</uri>
      <pose>-19.184401 173.440430 0.75 0 0 0</pose>
    </include>

    <!-- Unhealthy Leaf (Condition Check) -->
    <include>
      <name>unhealthy_leaf_1</name>
      <uri>model://leaf_scan</uri>
      <pose>3 2.5 1.25 0 0 0</pose>
    </include>

    <!-- Harvestable Tomato Fruit -->
    <include>
      <name>tomato_fruit_1</name>
      <uri>model://tomato</uri>
      <pose>-18.022100 184.173050 7.397340 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_2</name>
      <uri>model://tomato</uri>
      <pose>17.251000 124.147000 5.947100 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_3</name>
      <uri>model://tomato</uri>
      <pose>-24.916800 35.514200 5.097000 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_4</name>
      <uri>model://tomato</uri>
      <pose>18.517401 166.456497 8.845720 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_5</name>
      <uri>model://tomato</uri>
      <pose>-18.741899 172.841766 6.857740 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_6</name>
      <uri>model://tomato</uri>
      <pose>-16.222799 223.334122 7.894010 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_7</name>
      <uri>model://tomato</uri>
      <pose>-20.290298 114.668999 5.374050 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_8</name>
      <uri>model://tomato</uri>
      <pose>23.098801 37.560902 3.802257 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_9</name>
      <uri>model://tomato</uri>
      <pose>-14.645500 7.605003 6.223570 0 0 0</pose>
    </include>
    <include>
      <name>tomato_fruit_10</name>
      <uri>model://tomato</uri>
      <pose>-23.171499 48.428997 4.593790 0 0 0</pose>
    </include>

  </world>
</sdf>
