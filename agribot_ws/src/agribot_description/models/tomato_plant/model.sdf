<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tomato_plant">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 1.5708 0 0</pose>
      <!--
        Keep the mesh visual-only, but add a simple collision volume that
        spans the long stem / vine mass so 2D LiDAR can map persistent plants.
        The link is rolled 90 deg, so the box Y axis becomes world Z.
      -->
      <collision name="plant_collision">
        <geometry>
          <box>
            <size>0.02 0.10 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/tomato_plant.glb</uri>
            <scale>0.002 0.002 0.002</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
