<?xml version="1.0" ?>
<!--
  AgriBot - Smart Farm Robot Model
  Features: Differential Drive, RGB-D Camera, 2D LiDAR, IMU
  
  Coordinate System:
    X = forward, Y = left, Z = up
    Model origin is at center of base_link
    World spawn pose: 0 0 0.2 → wheels touch ground at z=0
-->
<sdf version="1.9">
  <model name="agribot">
    <static>false</static>

    <!-- ==================== BASE LINK (Robot Body) ==================== -->
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.042</ixx>
          <iyy>0.058</iyy>
          <izz>0.067</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Simple box collision for physics -->
      <collision name="chassis_collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.21 0.105</size>
          </box>
        </geometry>
      </collision>

      <!-- 3D model visual (rotated to stand upright) -->
      <visual name="visual">
        <pose>0 0 0.25 1.5708 0 1.5708</pose>
        <geometry>
          <mesh>
            <uri>meshes/agribot_gazebo.obj</uri>
            <scale>0.14 0.14 0.14</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ==================== LEFT WHEEL ==================== -->
    <link name="left_wheel">
      <pose relative_to="base_link">-0.07 0.1225 0.042 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.021</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.021</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================== RIGHT WHEEL ==================== -->
    <link name="right_wheel">
      <pose relative_to="base_link">-0.07 -0.1225 0.042 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.021</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.021</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================== CASTER WHEEL (Front) ==================== -->
    <link name="caster">
      <pose relative_to="base_link">0.15 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00007</ixx>
          <iyy>0.00007</iyy>
          <izz>0.00007</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.042</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.042</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================== CAMERA LINK (RGB-D) ==================== -->
    <link name="camera_link">
      <pose relative_to="base_link">0.2 0 0.3 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.03 0.06 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.0 0.8 1</ambient>
          <diffuse>0.0 0.0 1.0 1</diffuse>
        </material>
      </visual>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <topic>agribot/camera</topic>
        <update_rate>4</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>424</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>25.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- ==================== LIDAR LINK (2D) ==================== -->
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.245 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
        </material>
      </visual>
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>agribot/lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.35</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- ==================== IMU LINK ==================== -->
    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <topic>agribot/imu</topic>
        <update_rate>25</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- ==================== HARVEST ARM (Mesh Visual + Primitive Collision) ==================== -->
    <link name="harvest_arm_link">
      <pose relative_to="base_link">0.04 0 0.29 0 0.15 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.012</ixx>
          <iyy>0.018</iyy>
          <izz>0.016</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="arm_column_collision">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.18</size>
          </box>
        </geometry>
      </collision>
      <collision name="arm_reach_collision">
        <pose>0.12 0 0.19 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <collision name="arm_wrist_collision">
        <pose>0.25 0 0.22 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
      </collision>
      <collision name="gripper_left_collision">
        <pose>0.29 0.028 0.27 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.014 0.10</size>
          </box>
        </geometry>
      </collision>
      <collision name="gripper_right_collision">
        <pose>0.29 -0.028 0.27 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.014 0.10</size>
          </box>
        </geometry>
      </collision>

      <visual name="arm_mesh_visual">
        <pose>-0.025 0 0.081 3.1416 -1.5708 1.5708</pose>
        <geometry>
          <mesh>
            <uri>meshes/robotic_arm.glb</uri>
            <scale>5.236 6.007 2.536</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- ==================== HARVEST BASKET (Placeholder Geometry) ==================== -->
    <link name="harvest_basket_link">
      <pose relative_to="base_link">-0.14 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.008</ixx>
          <iyy>0.010</iyy>
          <izz>0.011</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="basket_floor_collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.14 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.6</mu>
              <mu2>1.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="basket_left_wall_collision">
        <pose>0 0.06 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.02 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="basket_right_wall_collision">
        <pose>0 -0.06 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.02 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="basket_front_wall_collision">
        <pose>0.08 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.14 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="basket_back_wall_collision">
        <pose>-0.08 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.14 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="basket_floor_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.14 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.20 0.10 1</ambient>
          <diffuse>0.46 0.28 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="basket_left_wall_visual">
        <pose>0 0.06 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.02 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.20 0.10 1</ambient>
          <diffuse>0.46 0.28 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="basket_right_wall_visual">
        <pose>0 -0.06 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.02 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.20 0.10 1</ambient>
          <diffuse>0.46 0.28 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="basket_front_wall_visual">
        <pose>0.08 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.14 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.20 0.10 1</ambient>
          <diffuse>0.46 0.28 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="basket_back_wall_visual">
        <pose>-0.08 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.14 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.20 0.10 1</ambient>
          <diffuse>0.46 0.28 0.16 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ==================== JOINTS ==================== -->
    <!-- Left Wheel Joint -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
        <dynamics>
          <damping>0.35</damping>
          <friction>0.20</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Right Wheel Joint -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
        <dynamics>
          <damping>0.35</damping>
          <friction>0.20</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Caster Joint (free-spinning ball) -->
    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <!-- Camera Joint (fixed to body) -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- LiDAR Joint (fixed to body) -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- IMU Joint (fixed to body) -->
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- Harvest Arm Joint -->
    <joint name="harvest_arm_joint" type="revolute">
      <parent>base_link</parent>
      <child>harvest_arm_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.60</lower>
          <upper>0.70</upper>
        </limit>
        <dynamics>
          <damping>1.50</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Harvest Basket Joint (fixed placeholder for P0 basket loading) -->
    <joint name="harvest_basket_joint" type="fixed">
      <parent>base_link</parent>
      <child>harvest_basket_link</child>
    </joint>

    <!-- ==================== PLUGINS ==================== -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>harvest_arm_joint</joint_name>
      <topic>/agribot/harvest_arm_joint/cmd_pos</topic>
      <p_gain>16.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>1.2</d_gain>
      <cmd_max>40.0</cmd_max>
      <cmd_min>-40.0</cmd_min>
    </plugin>

    <!-- Differential Drive Controller -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.245</wheel_separation>
      <wheel_radius>0.042</wheel_radius>
      <!-- Raise the drivetrain ceiling to support 1.6 m/s cruise while
           keeping acceleration and jerk bounded enough for Nav2 tracking. -->
      <max_linear_velocity>1.60</max_linear_velocity>
      <min_linear_velocity>-1.60</min_linear_velocity>
      <max_linear_acceleration>0.80</max_linear_acceleration>
      <min_linear_acceleration>-0.80</min_linear_acceleration>
      <max_linear_jerk>1.20</max_linear_jerk>
      <min_linear_jerk>-1.20</min_linear_jerk>
      <max_angular_velocity>3.20</max_angular_velocity>
      <min_angular_velocity>-3.20</min_angular_velocity>
      <max_angular_acceleration>1.00</max_angular_acceleration>
      <min_angular_acceleration>-1.00</min_angular_acceleration>
      <max_angular_jerk>1.50</max_angular_jerk>
      <min_angular_jerk>-1.50</min_angular_jerk>
      <topic>cmd_vel_safe</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>15</odom_publish_frequency>
    </plugin>

    <!-- IMU Sensor System -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <!-- Joint State Publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>

  </model>
</sdf>
